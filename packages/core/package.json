{
  "name": "@pubshift/core",
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "//emit": "Subpaths so a consumer outside the web app (packages/cli) can reach an emitter without a bundler alias. apps/web keeps using its own @emit/* alias, which swaps in a stub for an emitter that is not written yet; this does not.",
    "./emit/pptx": "./src/emit/pptx.ts",
    "./emit/docx": "./src/emit/docx.ts",
    "./emit/pdf": "./src/emit/pdf.ts",
    "./emit/svg": "./src/emit/svg.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "@pdf-lib/fontkit": "^1.1.1"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "@types/node": "^22.10.2"
  }
}
