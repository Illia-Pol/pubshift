# Pubshift environment
#
# Copy to .env.local (gitignored) to run locally. On a host, set these in the host's
# own environment/secrets UI — never commit real keys, and never put a secret key in a
# variable whose name starts with NEXT_PUBLIC_, because that prefix means "inline this
# into the JavaScript every visitor downloads".
#
# EVERYTHING BELOW IS OPTIONAL. With none of it set, the site builds as a pure static
# export and the free converter works completely: drop a .pub file, get a PowerPoint
# back, nothing uploaded, no account. That is the product. The paid surface simply does
# not render.


# ---------------------------------------------------------------------- site --

# Absolute origin, no trailing slash. Used for canonical URLs, Open Graph, and the
# success/cancel URLs handed to Stripe.
NEXT_PUBLIC_SITE_URL=https://pubshift.app


# ------------------------------------------------------------------ payments --

# Master switch, read at BUILD time by next.config.mjs.
#
#   unset / anything else   the Stripe routes are not compiled and `output: 'export'`
#                           produces a static site. This is the default and the one
#                           that costs nothing to host.
#   1                       the Stripe routes are compiled, so the build is a server
#                           application and needs a Node runtime somewhere.
#
# This is the single line that decides whether Pubshift needs a server at all.
PUBSHIFT_PAYMENTS=

# Shows the paid surface in the UI. Separate from PUBSHIFT_PAYMENTS on purpose: it is
# public and build-time, so it can be turned off to hide the offer without tearing down
# the endpoints that in-flight checkouts and webhook retries still need.
NEXT_PUBLIC_PAYMENTS_ENABLED=

# Stripe secret key. Server-side only. `sk_test_…` until you mean it.
# Dashboard -> Developers -> API keys.
STRIPE_SECRET_KEY=

# Signing secret for the webhook endpoint, NOT an API key. Starts `whsec_`.
# Dashboard -> Developers -> Webhooks -> your endpoint -> "Signing secret".
# `stripe listen` prints a different one for local testing; use that one locally.
#
# Without this the webhook cannot be verified, so lib/payments.ts treats the whole
# payment configuration as absent rather than accept unverified events. That is
# deliberate: a half-configured Stripe takes money and never fulfils it.
STRIPE_WEBHOOK_SECRET=

# The Price object for the batch runner — `price_…`, not `prod_…`.
# Dashboard -> Product catalogue -> your product -> Pricing.
# The amount lives in Stripe, not in this repo, so changing the price is not a deploy.
STRIPE_PRICE_ID=
