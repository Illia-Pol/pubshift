node_modules/
# The native extractor's output, at the repository root only. `bin/` unanchored also
# swallowed packages/cli/bin/pubshift.mjs, which is source and is what npm puts on
# the PATH — the command would have been missing from a fresh clone.
/bin/
dist/
# Copied out of wasm/ by packages/cli/build.mjs; regenerated by `npm run build`.
packages/cli/vendor/
.next/
wasm/build/
wasm/dist/*.wasm
*.log
.DS_Store
/tmp/
third_party/
dist-source/
apps/web/public/wasm/
apps/web/public/licences/THIRD-PARTY-NOTICES.md

# fidelity harness renders and diff images (generated, large, regenerate with `node tools/fidelity/compare.mjs`)
tools/fidelity/.artifacts/
tools/fidelity/.artifacts/
apps/web/out/
apps/web/.next/
apps/web/tsconfig.tsbuildinfo
native/build/
native/build.sh.bak

# Машинная конфигурация: личность и ssh-алиас этого проекта.
# Подключается из ~/.gitconfig по includeIf и не должна лежать в публичном репозитории.
# Как воссоздать — см. CLAUDE.md.
.gitconfig
